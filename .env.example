# Public environment template. Copy to .env locally.
VITE_SMARTMARKET_API_BASE_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000
VITE_APP_ENV=development

# Demo/mock API (MSW) — set to true to run without the live backend in development.
# Set to false when SmartMarket Lite API is running on port 5000.
VITE_USE_MOCK_API=true
